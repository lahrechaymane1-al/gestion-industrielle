# Django core config
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# First-login admin bootstrap (used only if there are no users yet)
APP_DEFAULT_ADMIN_USERNAME=admin
APP_DEFAULT_ADMIN_PASSWORD=change-this-password
APP_DEFAULT_ADMIN_EMAIL=
